rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidNumber(val, minVal) {
      return val is int || val is float && val >= minVal;
    }

    // Collection validation helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'xp', 'level'])
          && data.uid == request.auth.uid
          && isValidString(data.name, 100)
          && data.xp is int && data.xp >= 0
          && data.level is int && data.level >= 1;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'color'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && isValidString(data.name, 100)
          && isValidString(data.color, 50);
    }

    function isValidTopic(data) {
      return data.keys().hasAll(['id', 'userId', 'subjectId', 'title', 'priority', 'isCompleted'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && isValidString(data.subjectId, 128)
          && isValidString(data.title, 150)
          && data.isCompleted is bool;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'priority', 'isCompleted'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && isValidString(data.title, 200)
          && data.isCompleted is bool;
    }

    function isValidGoal(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'stage', 'progress'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && isValidString(data.title, 200)
          && isValidString(data.stage, 50)
          && data.progress is int || data.progress is float;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content', 'isFavorite', 'isPinned'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && isValidString(data.title, 200)
          && isValidString(data.content, 50000)
          && data.isFavorite is bool
          && data.isPinned is bool;
    }

    function isValidRevision(data) {
      return data.keys().hasAll(['id', 'userId', 'topicId', 'scheduledDate', 'isCompleted'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && isValidString(data.topicId, 128)
          && isValidString(data.scheduledDate, 100)
          && data.isCompleted is bool;
    }

    function isValidAchievement(data) {
      return data.keys().hasAll(['id', 'userId', 'code', 'unlockedAt'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && isValidString(data.code, 100);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'body', 'isRead', 'createdAt'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && isValidString(data.title, 200)
          && isValidString(data.body, 500)
          && data.isRead is bool;
    }

    function isValidPomodoroSession(data) {
      return data.keys().hasAll(['id', 'userId', 'duration', 'mode', 'createdAt'])
          && data.userId == request.auth.uid
          && isValidString(data.id, 128)
          && data.duration is int
          && isValidString(data.mode, 50);
    }

    // Rules matching the users collections
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /subjects/{subjectId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSubject(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /topics/{topicId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTopic(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTask(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidGoal(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNote(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /revisions/{revisionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidRevision(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /achievements/{achievementId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAchievement(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidNotification(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /pomodoroSessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPomodoroSession(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
